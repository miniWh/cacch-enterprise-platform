<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.cacch</groupId>
        <artifactId>cacch-enterprise-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>cacch-enterprise-service</artifactId>
    <packaging>jar</packaging>
    <name>cacch-enterprise-service</name>
    <description>单聚合业务模块：单一业务域内的核心业务逻辑，不做跨域流程编排</description>

    <dependencies>
        <dependency>
            <groupId>com.cacch</groupId>
            <artifactId>cacch-enterprise-dao</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cacch</groupId>
            <artifactId>cacch-enterprise-common</artifactId>
        </dependency>
        <!-- Redis 读写（验证码、权限缓存回源等） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- 验证码生成等通用工具 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
