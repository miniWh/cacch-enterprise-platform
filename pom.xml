<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>com.cacch</groupId>
    <artifactId>cacch-enterprise-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>cacch-enterprise-platform</name>
    <description>Cacch 统一企业管理平台基座（模块化单体，后端单工程 + 前端单仓）</description>

    <!-- 前端 cacch-enterprise-ui 为独立 Vite 工程，不参与 Maven 构建 -->
    <modules>
        <module>cacch-enterprise-common</module>
        <module>cacch-enterprise-dao</module>
        <module>cacch-enterprise-service</module>
        <module>cacch-enterprise-manager</module>
        <module>cacch-enterprise-integration</module>
        <module>cacch-enterprise-async</module>
        <module>cacch-enterprise-web</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 三方依赖版本统一在本文件 dependencyManagement 中声明后，方可被子模块引用；子模块禁止自行指定版本号 -->
    </properties>
</project>
